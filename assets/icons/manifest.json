{
  "family": "Lucide",
  "package": "lucide-static",
  "version": "1.46.0",
  "license": "ISC with inherited Feather MIT notice",
  "foreground": {
    "name": "Ghost White",
    "value": "#F8F8FF"
  },
  "icons": {
    "action-overflow": "ellipsis-vertical",
    "settings": "settings",
    "action-add": "plus",
    "keep-open": "pin",
    "clear": "trash-2",
    "collapse": "chevron-up",
    "expand": "chevron-down",
    "session-lock": "lock",
    "session-logout": "log-out",
    "session-restart": "rotate-cw",
    "session-shutdown": "power",
    "session-sleep": "moon",
    "session-switch-user": "users",
    "configure": "sliders-horizontal",
    "brightness": "sun",
    "open-weather": "cloud-sun",
    "back": "chevron-left",
    "performance": "gauge",
    "calendar-larger": "maximize-2",
    "calendar-smaller": "minimize-2"
  },
  "exceptions": {
    "notification-animated": "qml/BellGlyph.qml (Lucide-derived segmented geometry for clapper and slash animation)",
    "network-wired": "qml/EthernetGlyph.qml (Lucide ethernet-port geometry drawn in the bell's line)"
  },
  "status": {
    "family": "Colloid (bold panel set, regular where bold has none)",
    "source": "https://github.com/vinceliuice/Colloid-icon-theme",
    "commit": "ceac6608ecd0e40025cbc2ebbd32bf0e0f4ebc6a",
    "license": "GPL-3.0-only",
    "directory": "colloid",
    "copied_by": "tools/status-glyphs.py",
    "mapping": "qml/StatusGlyphs.js"
  }
}
